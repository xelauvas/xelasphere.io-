# Copy this file to .env.docker and fill in the real values before building/running Docker
FLASK_SECRET_KEY=replace-me
FLASK_ENV=production
FLASK_RUN_PORT=5001
APP_BASE_URL=http://localhost:5001

# API keys
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://yourdomain.com
OPENROUTER_APP_NAME=XelaSphere
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_IMAGE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_IMAGE_SIZE=1024x1024

# Search providers
SEARCH_BACKEND=brave
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BING_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://yourdomain.com/auth/microsoft/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# Session configuration tweaks (optional)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
