{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ingest rate (accepted / duplicate / error)",
      "description": "Counter rate of mempalace_ingest_total, faceted by status. Accepted vs duplicate vs error is the primary ingest-health signal.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (status) (rate(mempalace_ingest_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Wake-up latency (hot/cold p50/p95/p99)",
      "description": "histogram_quantile over mempalace_wakeup_seconds_bucket. Hot vs cold label splits first-open vs cached-handle paths (spec §4.2).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, hot) (rate(mempalace_wakeup_seconds_bucket{layer=\"total\"}[5m])))", "legendFormat": "p50 hot={{hot}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, hot) (rate(mempalace_wakeup_seconds_bucket{layer=\"total\"}[5m])))", "legendFormat": "p95 hot={{hot}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le, hot) (rate(mempalace_wakeup_seconds_bucket{layer=\"total\"}[5m])))", "legendFormat": "p99 hot={{hot}}", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Outbox depth by status",
      "description": "Gauge: pending vs sent vs abandoned rows. Backpressure threshold is 50k (spec §4.1 line 188).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "xelasphere_mempalace_outbox_depth", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 50000 }] } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Circuit breaker state",
      "description": "0=closed, 1=half-open, 2=open. One row per gunicorn worker_pid.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "xelasphere_mempalace_circuit_state", "legendFormat": "pid {{worker_pid}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "color": "green" }, "1": { "text": "half", "color": "yellow" }, "2": { "text": "open", "color": "red" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Cache pressure (bytes vs 2G cap)",
      "description": "Sidecar embedding-cache bytes. MemoryHigh=2G in systemd unit (spec §7.2).",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "mempalace_cache_bytes", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0,
          "max": 2147483648,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1610612736 }, { "color": "red", "value": 2040109466 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Readyz",
      "description": "1=ready, 0=not-ready. Sidecar exposes via /readyz.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "up{job=\"mempalace-sidecar\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "READY", "color": "green" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 100,
      "panels": [
        {
          "id": 101,
          "type": "barchart",
          "title": "Top palaces by bytes (top 20)",
          "description": "Storage by user. Large-outlier investigation per runbook R11.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            { "expr": "topk(20, mempalace_palace_bytes)", "legendFormat": "{{user}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] }
        },
        {
          "id": 102,
          "type": "timeseries",
          "title": "Outbox age distribution (p50/p95/p99)",
          "description": "Pending-row age histogram; staleness signal. p95 climbing indicates flusher stall or sidecar slowness.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            { "expr": "histogram_quantile(0.50, sum by (le) (rate(xelasphere_mempalace_outbox_age_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
            { "expr": "histogram_quantile(0.95, sum by (le) (rate(xelasphere_mempalace_outbox_age_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
            { "expr": "histogram_quantile(0.99, sum by (le) (rate(xelasphere_mempalace_outbox_age_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
          ],
          "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
        },
        {
          "id": 103,
          "type": "timeseries",
          "title": "Open-error class trend",
          "description": "registry.open errors faceted by class (corrupt_meta, schema_too_new, other). R-number runbook trigger.",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            { "expr": "sum by (class) (rate(mempalace_open_errors_total[5m]))", "legendFormat": "{{class}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] }
        }
      ],
      "title": "Capacity (collapsed)",
      "type": "row"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["mempalace", "live"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MemPalace — Live",
  "uid": "mempalace-live",
  "version": 1,
  "weekStart": ""
}
