# /etc/systemd/system/xelasphere.service — FHS-compliant unit (issue #6).
#
# Replaces the pre-mempalace ad-hoc unit at
# /root/xelas.io/xelasphere.io- + User=root with spec §7.1's
# /opt/xelasphere + User=xelasphere layout. Pairs with
# mempalace-flusher.service which already expected this layout
# (User=xelasphere, EnvironmentFile=/etc/xelasphere/mempalace.env).
#
# Install via deploy/migrate-fhs.sh — do not symlink directly;
# the cutover script also moves the working tree, env file, and
# state directories in lockstep.

[Unit]
Description=XelaSphere Flask Application
After=network.target

[Service]
Type=simple
User=xelasphere
Group=xelasphere
WorkingDirectory=/opt/xelasphere

# Path: explicit so the service finds gunicorn from the project venv
# without relying on shell login profile. /usr/local/bin first so any
# system override (e.g. `mempalace-mode`) wins over a stale venv shim.
Environment=PATH=/opt/xelasphere/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Two env files load in declaration order; later values override earlier
# (systemd standard EnvironmentFile multiplicity).
#
# 1. xelasphere.env — Flask app config (firebase creds, API keys,
#    SESSION_FILE_DIR, etc.). Migrated from .env at cutover.
# 2. mempalace.env — MEMPALACE_MODE + LEGACY_MEMORY + token + socket
#    paths. Already in place from the flusher unit; Flask MUST also
#    load it so /usr/local/bin/mempalace-mode rotation actually flips
#    Flask's mode. The rotation script restarts xelasphere and probes
#    /admin/mempalace-mode for verification — without this second file
#    Flask never sees the new MEMPALACE_MODE value, defaults to "off"
#    via app/mempalace/feature_flag.py:85, and the rotation reports a
#    verify-fail WARN every time.
#
# This was a pre-existing drift in the live unit (the prior
# /root/xelas.io/...env did not contain MEMPALACE_MODE either; the
# live unit only loaded that file). Fixing it as part of the FHS
# migration so shadow rotation works on the first try post-cutover.
#
# Permissions on both files: root:xelasphere 0640 so operators need
# sudo to edit but the service user can read. Mirrors the pattern used
# by mempalace-flusher.service (mempalace.env) and the sidecar unit
# (/etc/mempalace/sidecar.env).
EnvironmentFile=/etc/xelasphere/xelasphere.env
EnvironmentFile=/etc/xelasphere/mempalace.env

# (Removed 2026-04-28 per issue #26.) The previous unit carried
# Environment=COVERAGE_ENABLED=1 as a development-time toggle. It
# instrumented every request, generated journal noise on every restart,
# and produced ~4000 stale .coverage.* data files in /var/log/xelasphere/coverage/
# without anyone consuming them. Production should not run with coverage
# instrumentation hot. If coverage is ever needed for a specific
# investigation, set it temporarily via `systemctl edit xelasphere`.

# /run/xelasphere is tmpfs-managed by systemd (RuntimeDirectory). The
# Prometheus multiproc dir lives under it. Same fix M0.26a applied
# to mempalace-sidecar.service: /run is root-owned tmpfs and the
# xelasphere user cannot mkdir there on reboot without help from
# systemd. Mode 0750 matches mempalace-flusher.service.
RuntimeDirectory=xelasphere
RuntimeDirectoryMode=0750

ExecStart=/opt/xelasphere/venv/bin/gunicorn -c gunicorn.conf.py run:app

# Crash recovery: restart-always with a 5s cool-off matches the prior
# unit's policy. systemd will give up if the unit fails 5 times in
# 10s (default StartLimitBurst), which is the right ceiling for a
# crash-loop break-glass.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
