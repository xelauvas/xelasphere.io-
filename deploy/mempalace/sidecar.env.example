# Environment file for mempalace-sidecar.service.
# Location: /etc/mempalace/sidecar.env (mode 0640, root:mempalace).
#
# Copy this file to /etc/mempalace/sidecar.env and fill in the values
# noted with <TODO>. provision.sh generates MEMPALACE_TOKEN and writes
# it to both this file and /etc/xelasphere/mempalace.env in one step
# (spec §7.3 step 4).

# Shared-secret token authenticating Flask-side requests. Generated once
# during provisioning; rotated via the ops runbook. Must match the
# MEMPALACE_TOKEN in /etc/xelasphere/mempalace.env exactly.
MEMPALACE_TOKEN=<TODO: generated by provision.sh>

# UDS path for the sidecar socket. Must match MEMPALACE_SOCKET in the
# Flask env file. Created on each sidecar start with mode 0660,
# owner mempalace:mempalace.
MEMPALACE_SOCKET=/run/mempalace/sidecar.sock

# Palace storage root. Sidecar creates per-user subdirectories under
# this path on first-write per user.
MEMPALACE_PALACES_DIR=/var/mempalace/palaces

# KG pending-queue + audit SQLite paths (sidecar-owned; not shared
# with Flask). kg_pending is durable queue for KG worker; audit.sqlite
# is append-only for admin operations.
MEMPALACE_KG_PENDING=/var/mempalace/kg_pending.sqlite
MEMPALACE_AUDIT_DB=/var/mempalace/audit.sqlite

# Prometheus multiproc directory. Wiped on each start by the systemd
# ExecStartPre. Location must match PROMETHEUS_MULTIPROC_DIR in the
# sidecar's main.py.
PROMETHEUS_MULTIPROC_DIR=/run/mempalace/prom

# User-ID pseudonymization salt. Used to compute sha256(user_id + salt)[:12]
# for structured log entries (spec §8.4). Rotating this salt invalidates
# historical log-correlations; do not rotate without an operator plan.
MEMPALACE_USER_ID_HASH_SALT=<TODO: 32-byte random, generated once>

# Embedding cache byte budget. Matches systemd unit MemoryHigh=2G.
MEMPALACE_CACHE_MAX_BYTES=2147483648

# Log level. DEBUG for initial rollout; INFO for steady state.
MEMPALACE_LOG_LEVEL=INFO
