# Environment file for Flask-side mempalace configuration.
# Location: /etc/xelasphere/mempalace.env (mode 0640, root:xelasphere).
#
# Separate from /etc/mempalace/sidecar.env (spec §7.1 "one-file-one-purpose").
# Flask's systemd unit EnvironmentFile= points here; the sidecar's unit
# points at its own file.

# Mempalace rollout mode. Phases:
#   off    — P0 dark-deploy default. No reads, no writes. record_turn
#            drops with inserts_dropped{reason="mode_off"}.
#   shadow — P1-P2 shadow phases. Writes to outbox + sidecar; shadow log
#            records mempalace-vs-legacy for rubric analysis. Prompt
#            injection uses legacy memory only.
#   active — P3+ full activation. Mempalace output replaces legacy in
#            prompt. Legacy writes still happen until LEGACY_MEMORY=off
#            at P4.
# Rotated via /usr/local/bin/mempalace-mode (see mempalace-mode script).
MEMPALACE_MODE=off

# Legacy memory subsystem gate. P0-P3 keep this on; P4 removes LEGACY_MEMORY
# and the default-off-both-refuses-boot logic in app/__init__.py (spec §3).
LEGACY_MEMORY=on

# Shared-secret token; must exactly match MEMPALACE_TOKEN in
# /etc/mempalace/sidecar.env. provision.sh writes both files atomically.
MEMPALACE_TOKEN=<TODO: generated by provision.sh>

# UDS path for sidecar socket. Must match MEMPALACE_SOCKET in sidecar.env.
MEMPALACE_SOCKET=/run/mempalace/sidecar.sock

# Outbox SQLite path. Single database shared between Flask gunicorn
# workers (write path) and the mempalace-flusher systemd unit (read path).
# WAL mode enabled; concurrent read/write safe.
MEMPALACE_OUTBOX_PATH=/var/lib/xelasphere/outbox.db

# Shadow-log directory. Daily-rotated shadow-YYYY-MM-DD.jsonl files;
# logrotate caps at 20 GB (spec §7.1).
MEMPALACE_SHADOW_DIR=/var/log/mempalace/shadow

# Post-P4 escape hatch (do not set before P4). When XELASPHERE_POST_P4=1,
# the startup sanity check allows MEMPALACE_MODE=off + LEGACY_MEMORY=off
# to boot with a WARN log rather than refuse. Required after LEGACY_MEMORY
# is removed; mempalace=off must remain a bootable outage-relief state.
# XELASPHERE_POST_P4=1
