# Flask Configuration
FLASK_ENV=development
FLASK_RUN_PORT=5000
FLASK_SECRET_KEY=your_secret_key_here
APP_BASE_URL=http://localhost:5000

# Session Configuration
SESSION_TYPE=filesystem
SESSION_FILE_DIR=./flask_session
SESSION_USE_SIGNER=true
SESSION_PERMANENT=false

# Firebase Configuration
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_CRED_PATH=path/to/xelas-firebase.json

# API Keys
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_SITE_URL=https://xelas.io
OPENROUTER_APP_NAME=XelaSphere
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_IMAGE_SIZE=1024x1024

# Search Configuration
SEARCH_BACKEND=brave
BRAVE_SEARCH_API_KEY=your_brave_api_key
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
SEARCH_BLOCKED_DOMAINS=zhihu.com,baidu.com,weibo.com,qq.com
BING_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# CORS Configuration
ALLOWED_ORIGINS=https://xelas.io,http://localhost:5000

# OAuth Configurations
# Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Microsoft
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/microsoft/callback

# Discord
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback

# Tesseract Configuration
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=eng
